# ==============================================================================
# LeadRadar - Variables de Entorno (Configuración)
# ==============================================================================

# Puerto en el que se expone la aplicación (por defecto: 3001)
PORT=3001

# Entorno de ejecución (development o production)
NODE_ENV=production

# Ruta del binario de Chromium (dentro del contenedor Docker es /usr/bin/chromium)
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# URL base de la API para el cliente (opcional, en Docker se autodetecta el origen)
# VITE_API_BASE_URL=http://localhost:3001
